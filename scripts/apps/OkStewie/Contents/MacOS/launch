#!/bin/bash
# Ok Stewie — opens your web app (http://127.0.0.1:8093), starting it if it is down.
set -u

export PATH="$HOME/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

URL="http://127.0.0.1:8093"
STATE="$HOME/.stewie"
mkdir -p "$STATE"

up() { curl -sf --max-time 1 "$URL/" >/dev/null 2>&1; }

if up; then
  open "$URL"
  exit 0
fi

SERVE_DIR="$HOME/okstewie-v2web-serve"
DIST="$HOME/okstewie-v2web-dist"
[ -d "$SERVE_DIR" ] || SERVE_DIR="$HOME/ok-stewie-partners-l5"
[ -d "$DIST" ] || DIST="$SERVE_DIR/dist"

cd "$SERVE_DIR" || exit 1
OKSTEWIE_DIST="$DIST" nohup /usr/local/bin/node serve-web.mjs >"$STATE/web.log" 2>&1 &

for _ in $(seq 1 80); do
  if up; then
    open "$URL"
    exit 0
  fi
  sleep 0.25
done

osascript -e 'display alert "Ok Stewie" message "The web app did not start. See ~/.stewie/web.log for details."' >/dev/null 2>&1
exit 1
